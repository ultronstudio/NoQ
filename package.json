{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "test:pwa": "node --test tests/pwa.test.mjs",
        "build:icons": "node scripts/generate-brand-assets.mjs",
        "build": "vp build",
        "dev": "php artisan config:clear && concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" --names=server,reverb,queue,vite --kill-others \"php artisan serve --tries=0\" \"php artisan reverb:start\" \"php artisan queue:listen --tries=1 --timeout=0\" \"npm run dev:vite\"",
        "dev:vite": "vp dev --strictPort"
    },
    "dependencies": {
        "@popperjs/core": "^2.11.8",
        "bootstrap": "^5.3.8",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "vite": "^8.0.0",
        "vite-plus": "0.3.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "devDependencies": {
        "laravel-echo": "^2.5.0",
        "pusher-js": "^8.6.0",
        "sass": "^1.104.1",
        "sharp": "^0.35.5"
    }
}
