Project NoQ {
  database_type: 'SQLite'

  Note: '''
    Doménové databázové schéma aplikace NoQ určené pro dokumentaci
    a E-R diagram maturitního projektu.

    Záměrně nejsou zahrnuty technické tabulky frameworku Laravel
    (cache, sessions, jobs, failed_jobs, password_reset_tokens, migrations apod.),
    protože nepopisují vlastní datový model aplikace NoQ.
  '''
}

Table users {
  id bigint [pk, increment]
  name varchar(255) [not null]
  email varchar(255) [not null, unique]
  password varchar(255) [not null]
  is_super_admin boolean [not null, default: false]
  created_at timestamp
  updated_at timestamp

  Note: '''
    Registrovaný uživatel systému. Může být vlastníkem fronty,
    vedoucím operátorem, pracovníkem přepážky nebo super administrátorem.
    Technická pole autentizace, která nejsou důležitá pro návrh projektu,
    jsou v diagramu zjednodušena.
  '''
}

Table virtual_queues {
  id bigint [pk, increment]
  user_id bigint [not null]
  public_id char(26) [not null, unique, note: 'Veřejný ULID používaný v URL a QR kódu.']
  name varchar(120) [not null]
  description varchar(500)
  max_waiting int [note: 'Maximální počet současně čekajících návštěvníků.']
  archived_at timestamp
  created_at timestamp
  updated_at timestamp

  Note: '''
    Základní definice virtuální fronty.
    user_id určuje vlastníka fronty.
  '''
}

Table queue_sessions {
  id bigint [pk, increment]
  virtual_queue_id bigint [not null]
  opened_by_user_id bigint [not null]
  closed_by_user_id bigint
  status varchar(255) [not null, note: 'open | paused | closed']
  next_number int [not null, default: 1]
  opened_at timestamp [not null]
  closed_at timestamp
  created_at timestamp
  updated_at timestamp

  Note: '''
    Jeden konkrétní běh fronty. Jedna virtual_queue může mít v čase
    více session, ale aplikační logika povoluje nejvýše jednu aktivní.
  '''
}

Table service_points {
  id bigint [pk, increment]
  virtual_queue_id bigint [not null]
  name varchar(80) [not null]
  sort_order smallint [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamp
  updated_at timestamp

  Indexes {
    (virtual_queue_id, name) [unique]
  }

  Note: 'Obslužná místa nebo přepážky patřící ke konkrétní frontě.'
}

Table queue_entries {
  id bigint [pk, increment]
  queue_session_id bigint [not null]
  service_point_id bigint
  tracking_token_hash char(64) [not null, unique]
  number int [not null]
  status varchar(255) [not null, note: 'waiting | called | completed | cancelled | no_show']
  created_at timestamp
  updated_at timestamp

  Indexes {
    (queue_session_id, number) [unique]
  }

  Note: '''
    Anonymní pořadový lístek návštěvníka.
    Pozice ve frontě se neukládá samostatně, ale odvozuje se
    z pořadového čísla a aktuálního stavu záznamů.
  '''
}

Table queue_entry_status_changes {
  id bigint [pk, increment]
  queue_entry_id bigint [not null]
  from_status varchar(255)
  to_status varchar(255) [not null]
  actor varchar(255) [not null, note: 'visitor | operator | system']
  changed_by_user_id bigint
  service_point_id bigint
  created_at timestamp [not null]

  Note: '''
    Auditní historie změn stavu pořadového lístku.
    Záznamy jsou neměnné a nemají updated_at.
  '''
}

Table role_assignments {
  id bigint [pk, increment]
  user_id bigint [not null]
  role varchar(255) [not null, note: 'queue_supervisor | service_point_worker']
  virtual_queue_id bigint [not null]
  service_point_id bigint
  created_at timestamp
  updated_at timestamp

  Indexes {
    (user_id, role, virtual_queue_id, service_point_id) [unique]
  }

  Note: '''
    Delegovaná oprávnění uživatelů.
    Vlastník fronty je určen přímo přes virtual_queues.user_id.
    Super administrátor je určen přes users.is_super_admin.
  '''
}

// RELACE

Ref: virtual_queues.user_id > users.id [delete: restrict]

Ref: queue_sessions.virtual_queue_id > virtual_queues.id [delete: cascade]
Ref: queue_sessions.opened_by_user_id > users.id [delete: restrict]
Ref: queue_sessions.closed_by_user_id > users.id [delete: set null]

Ref: service_points.virtual_queue_id > virtual_queues.id [delete: cascade]

Ref: queue_entries.queue_session_id > queue_sessions.id [delete: cascade]
Ref: queue_entries.service_point_id > service_points.id [delete: set null]

Ref: queue_entry_status_changes.queue_entry_id > queue_entries.id [delete: cascade]
Ref: queue_entry_status_changes.changed_by_user_id > users.id [delete: set null]
Ref: queue_entry_status_changes.service_point_id > service_points.id [delete: set null]

Ref: role_assignments.user_id > users.id [delete: cascade]
Ref: role_assignments.virtual_queue_id > virtual_queues.id [delete: cascade]
Ref: role_assignments.service_point_id > service_points.id [delete: cascade]
